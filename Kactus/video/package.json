{
  "name": "kactus-video",
  "private": true,
  "version": "0.1.0",
  "description": "Video animado 'Como funciona o Kactus' (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts --port 3022",
    "storyboard": "tsx scripts/storyboard.ts",
    "render": "remotion render src/index.ts ComoFuncionaKactus out/como-funciona-kactus.mp4",
    "vozes": "uv run --with edge-tts --with miniaudio python scripts/gerar_vozes.py",
    "legendas": "tsx scripts/legendas.ts",
    "folhas": "tsx scripts/folhas.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.536",
    "@remotion/cli": "4.0.536",
    "@remotion/media-utils": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3",
    "tsx": "4.19.2"
  }
}
