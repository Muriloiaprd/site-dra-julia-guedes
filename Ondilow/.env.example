DATABASE_URL=postgresql+psycopg://ondilow:ondilow@localhost:5432/ondilow

JWT_SECRET_KEY=troque_isso_por_uma_string_aleatoria_de_64_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

ALLOW_REGISTRATION=false
INITIAL_USER_EMAIL=muriloiaprd@hotmail.com
INITIAL_USER_PASSWORD=troque_isso_agora

FERNET_KEY=

APP_ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

GPS_DOWNSAMPLE_SECONDS=3

DATA_DIR=./data
# Em deploy sem disco persistente (Render/Fly free), desligar:
LOG_TO_FILE=true
PERSIST_RAW_UPLOADS=true

# IA (Duni). Opcional; sem chave o recurso responde erro amigavel.
# Gemini free tier, chave gratis e sem cartao em aistudio.google.com/apikey.
GEMINI_API_KEY=
# Lista em ordem de preferencia; o proximo so entra se o anterior der 503/504.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.5-flash
# Anthropic e paga: fica vazia pela regra de custo zero do projeto.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
COACH_PROMPT_VERSION=v2
